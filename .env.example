# TSLPRB StudyOS - Environment Variables
# NEVER commit the actual .env file - it is in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase Dashboard > Project > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Cloudinary (image hosting) ────────────────────────────────────────────────
# Cloudinary Dashboard > Settings > API Keys
# Cloud name is visible at top-left of the dashboard
CLOUDINARY_CLOUD_NAME=gbxjgmck
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
