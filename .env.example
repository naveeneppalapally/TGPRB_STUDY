# TSLPRB StudyOS - Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit the actual .env file - it is in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard > Project > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# CLOUDFLARE_ACCOUNT_ID: visible in the right sidebar of any CF dashboard page
# R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY: from R2 > Manage API Tokens
# R2_PUBLIC_URL: from R2 bucket > Settings > Public access (looks like https://pub-xxxx.r2.dev)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tslprb-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Cloudflare (auto-injected by CF build environment) ────────────────────────
# CF_PAGES=1  <- do NOT set this manually; Cloudflare sets it during builds

# ── Local dev only ────────────────────────────────────────────────────────────
# PORT=3000
