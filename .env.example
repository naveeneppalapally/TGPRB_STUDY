# TSLPRB StudyOS - Environment Variables
# NEVER commit the actual .env file - it is in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase Dashboard > Project > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Cloudinary (image hosting) ────────────────────────────────────────────────
# Cloudinary Dashboard > Settings > API Keys
# Cloud name is visible at top-left of the dashboard
CLOUDINARY_CLOUD_NAME=gbxjgmck
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Vertex AI study assistant ─────────────────────────────────────────
# Create a minimal service account with Vertex AI User access. Store this exact
# JSON as one encrypted Cloudflare Pages secret, never in a committed file.
NUXT_VERTEX_PROJECT=your-google-cloud-project-id
NUXT_VERTEX_LOCATION=global
NUXT_GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
NUXT_AI_MODEL=gemini-2.5-flash
NUXT_AI_DAILY_QUERY_LIMIT=20
