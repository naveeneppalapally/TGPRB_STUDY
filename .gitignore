# Dependencies
node_modules/

# Nuxt build artifacts
.nuxt/
.output/
dist/

# IMAGES MUST NEVER BE IN GIT - use R2 via scripts/upload-image.ts
# Every image goes through that script; never commit to public/images/
public/images/

# Environment secrets - NEVER commit these
.env
.env.local
.env.*.local

# Wrangler local state
.wrangler/
.dev.vars

# Nuxt Content SQLite cache (auto-generated, not source)
.data/

# Large binaries and archives - do not commit
*.zip
*.tar.gz
*.sqlite
*.db

# OS / editor
.DS_Store
.directory
Thumbs.db
.idea/
.vscode/settings.json

# Logs
*.log
npm-debug.log*

# Python cache
__pycache__/
*.pyc

# PIB raw SQLite corpus (local only)
workers/scrapy-pib/*.db
workers/scrapy-pib/*.csv
workers/scrapy-pib/__pycache__/
